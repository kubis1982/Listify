rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// NOTE: The Angular app does not use Firestore yet (it currently persists
// everything to localStorage). This schema is a forward design based on the
// existing local models (Category, Product, Unit, ShoppingList) plus a
// sharing-ready shape for shopping lists, agreed with the project owner:
//   - categories / products / units: private per authenticated user.
//   - shoppingLists: owned by one user today, but modeled from the start so a
//     list can later be shared with other members (memberIds).
//
// Collection: users/{userId}/categories/{categoryId}
// Fields:
//   - id: string (required, immutable, must equal categoryId)
//   - name: string (required, 1-100 chars)
//
// Collection: users/{userId}/products/{productId}
// Fields:
//   - id: string (required, immutable, must equal productId)
//   - name: string (required, 1-200 chars)
//   - unitSymbol: string (required, 1-20 chars)
//   - categoryName: string (required, 1-100 chars)
//
// Collection: users/{userId}/units/{unitId}
// Fields:
//   - id: string (required, immutable, must equal unitId)
//   - symbol: string (required, 1-20 chars)
//   - isDefault: bool (optional)
//
// Collection: shoppingLists/{listId}  (top-level, sharing-ready)
// Fields:
//   - id: string (required, immutable, must equal listId)
//   - name: string (required, 1-200 chars)
//   - createdAt: timestamp (required, immutable)
//   - status: string (required, one of 'active' | 'completed')
//   - ownerId: string (required, immutable, must equal creator's uid)
//   - memberIds: list<string> (required, 1-20 entries, must always contain
//     ownerId; only the owner may change this field once the list exists)
//   - items: list<map> (required, 0-500 entries), each item:
//       - id: string (required, 1-100 chars)
//       - productName: string (required, 1-200 chars)
//       - unitLabel: string (required, 0-20 chars)
//       - categoryName: string (required, 0-100 chars)
//       - quantity: number (required, > 0, < 100000)
//       - purchased: bool (required)
//       - note: string (optional, 0-500 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validStringLength(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || validStringLength(data[field], minLen, maxLen);
    }

    function isPositive(value) {
      return value is number && value > 0;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidCategory(data, categoryId) {
      return hasOnlyAllowedFields(data, ['id', 'name']) &&
        hasRequiredFields(data, ['id', 'name']) &&
        data.id is string && data.id == categoryId &&
        validStringLength(data.name, 1, 100);
    }

    function isValidProduct(data, productId) {
      return hasOnlyAllowedFields(data, ['id', 'name', 'unitSymbol', 'categoryName']) &&
        hasRequiredFields(data, ['id', 'name', 'unitSymbol', 'categoryName']) &&
        data.id is string && data.id == productId &&
        validStringLength(data.name, 1, 200) &&
        validStringLength(data.unitSymbol, 1, 20) &&
        validStringLength(data.categoryName, 1, 100);
    }

    function isValidUnit(data, unitId) {
      return hasOnlyAllowedFields(data, ['id', 'symbol', 'isDefault']) &&
        hasRequiredFields(data, ['id', 'symbol']) &&
        data.id is string && data.id == unitId &&
        validStringLength(data.symbol, 1, 20) &&
        (!('isDefault' in data) || data.isDefault is bool);
    }

    function isValidShoppingListItem(item) {
      return item is map &&
        item.keys().hasOnly(['id', 'productName', 'unitLabel', 'categoryName', 'quantity', 'purchased', 'note']) &&
        item.keys().hasAll(['id', 'productName', 'unitLabel', 'categoryName', 'quantity', 'purchased']) &&
        validStringLength(item.id, 1, 100) &&
        validStringLength(item.productName, 1, 200) &&
        validStringLength(item.unitLabel, 0, 20) &&
        validStringLength(item.categoryName, 0, 100) &&
        isPositive(item.quantity) && item.quantity < 100000 &&
        item.purchased is bool &&
        isValidOptionalString(item, 'note', 0, 500);
    }

    function isValidItemsList(items) {
      return items is list && items.size() <= 500 &&
        items.all(item, isValidShoppingListItem(item));
    }

    function isValidMemberIds(memberIds, ownerId) {
      return memberIds is list && memberIds.size() >= 1 && memberIds.size() <= 20 &&
        ownerId in memberIds &&
        memberIds.all(uid, validStringLength(uid, 1, 128));
    }

    function isValidShoppingList(data, listId) {
      return hasOnlyAllowedFields(data, ['id', 'name', 'createdAt', 'status', 'ownerId', 'memberIds', 'items']) &&
        hasRequiredFields(data, ['id', 'name', 'createdAt', 'status', 'ownerId', 'memberIds', 'items']) &&
        data.id is string && data.id == listId &&
        validStringLength(data.name, 1, 200) &&
        data.createdAt is timestamp &&
        data.status in ['active', 'completed'] &&
        validStringLength(data.ownerId, 1, 128) &&
        isValidMemberIds(data.memberIds, data.ownerId) &&
        isValidItemsList(data.items);
    }

    function isMember(memberIds) {
      return isAuthenticated() && request.auth.uid in memberIds;
    }

    // Only the list owner may change who has access to the list; other
    // members may still edit name/status/items.
    function membershipUnchangedUnlessOwner() {
      return resource.data.ownerId == request.auth.uid ||
        areImmutableFieldsUnchanged(['ownerId', 'memberIds']);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {

      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory(request.resource.data, categoryId);
        allow update: if isOwner(userId) && isValidCategory(request.resource.data, categoryId);
        allow delete: if isOwner(userId);
      }

      match /products/{productId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProduct(request.resource.data, productId);
        allow update: if isOwner(userId) && isValidProduct(request.resource.data, productId);
        allow delete: if isOwner(userId);
      }

      match /units/{unitId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUnit(request.resource.data, unitId);
        allow update: if isOwner(userId) && isValidUnit(request.resource.data, unitId);
        allow delete: if isOwner(userId);
      }
    }

    match /shoppingLists/{listId} {
      allow read: if isMember(resource.data.memberIds);

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        isValidShoppingList(request.resource.data, listId);

      allow update: if isMember(resource.data.memberIds) &&
        isValidShoppingList(request.resource.data, listId) &&
        areImmutableFieldsUnchanged(['id', 'createdAt', 'ownerId']) &&
        membershipUnchangedUnlessOwner();

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }
  }
}
